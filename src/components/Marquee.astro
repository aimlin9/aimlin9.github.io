---
interface Props {
  items: string[];
}
const { items } = Astro.props;
const loop = [...items, ...items];
---

<div class="relative overflow-hidden border-y border-hairline bg-accent py-4" aria-hidden="true">
  <div class="marquee-track flex w-max items-center gap-10 whitespace-nowrap">
    {
      loop.map((item) => (
        <span class="flex items-center gap-10">
          <span class="font-display text-2xl font-semibold uppercase tracking-tight text-black md:text-3xl">
            {item}
          </span>
          <span class="text-2xl text-black/40 md:text-3xl">✦</span>
        </span>
      ))
    }
  </div>
</div>
