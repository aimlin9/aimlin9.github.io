---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ShowcaseImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  variant: "laptop" | "laptop-phone";
  screens: ShowcaseImage[];
  phoneScreens?: ShowcaseImage[];
  secondsEach?: number;
}

const { variant, screens, phoneScreens = [], secondsEach = 3 } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);

function buildCss(name: string, count: number, seconds: number) {
  const slot = 100 / count;
  const fade = Math.min(slot * 0.22, 6);
  return `
    @keyframes ${name} {
      0% { opacity: 1; }
      ${(slot - fade).toFixed(2)}% { opacity: 1; }
      ${slot.toFixed(2)}% { opacity: 0; }
      ${(100 - fade).toFixed(2)}% { opacity: 0; }
      100% { opacity: 1; }
    }
  `;
}

const laptopAnim = `laptop-fade-${uid}`;
const phoneAnim = `phone-fade-${uid}`;
const laptopTotal = screens.length * secondsEach;
const phoneTotal = phoneScreens.length * secondsEach;

const css = [
  buildCss(laptopAnim, screens.length, secondsEach),
  phoneScreens.length ? buildCss(phoneAnim, phoneScreens.length, secondsEach) : "",
].join("\n");
---

<style is:inline set:html={css} />

<div class="relative mx-auto w-full max-w-2xl select-none" data-reveal>
  <!-- Laptop -->
  <div class="relative rounded-t-2xl border border-hairline-strong bg-gradient-to-b from-[#141414] to-[#0a0a0a] p-[2.4%] shadow-[0_40px_80px_rgba(0,0,0,0.55)]">
    <div class="absolute left-1/2 top-[1.1%] h-[5px] w-[5px] -translate-x-1/2 rounded-full bg-[#2a2a2a]"></div>
    <div class="relative aspect-[16/10] w-full overflow-hidden rounded-[0.4rem] bg-[#050505] ring-1 ring-black/60">
      {
        variant === "laptop" ? (
          screens.map((img, i) => (
            <Image
              src={img.src}
              alt={img.alt}
              width={1000}
              height={625}
              class="absolute inset-0 h-full w-full object-cover object-top"
              style={`animation: ${laptopAnim} ${laptopTotal}s ease-in-out infinite; animation-delay: ${-(i * secondsEach)}s;`}
            />
          ))
        ) : (
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(255,90,31,0.10),transparent_60%)]">
            <div
              class="absolute inset-0 opacity-[0.12]"
              style="background-image: linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px); background-size: 28px 28px;"
            />
          </div>
        )
      }
    </div>
  </div>
  <!-- Base / keyboard deck -->
  <div class="relative mx-auto h-[14px] w-[104%] -translate-x-[2%] rounded-b-2xl border-x border-b border-hairline-strong bg-gradient-to-b from-[#161616] to-[#040404]">
    <div class="absolute left-1/2 top-0 h-[4px] w-[14%] -translate-x-1/2 rounded-b-md bg-[#050505]"></div>
  </div>

  {
    variant === "laptop-phone" && phoneScreens.length > 0 && (
      <div class="pointer-events-none absolute inset-0 flex justify-center pt-[3%]">
        <div class="relative aspect-[9/19] h-[68%] overflow-hidden rounded-[1.6rem] border-[3px] border-[#151515] bg-black shadow-[0_25px_60px_rgba(0,0,0,0.7)] ring-1 ring-white/10">
          <div class="absolute left-1/2 top-[6px] z-10 h-[5px] w-[30%] -translate-x-1/2 rounded-full bg-[#0a0a0a]" />
          {phoneScreens.map((img, i) => (
            <Image
              src={img.src}
              alt={img.alt}
              width={480}
              height={1040}
              class="absolute inset-0 h-full w-full object-cover"
              style={`animation: ${phoneAnim} ${phoneTotal}s ease-in-out infinite; animation-delay: ${-(i * secondsEach)}s;`}
            />
          ))}
        </div>
      </div>
    )
  }
</div>
