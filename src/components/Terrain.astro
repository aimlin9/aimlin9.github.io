---
interface Props {
  class?: string;
  heightClass?: string;
  opacityClass?: string;
}
const { class: klass = "", heightClass = "h-[52%]", opacityClass = "opacity-90" } = Astro.props;
---

<div class={`pointer-events-none absolute inset-x-0 bottom-0 z-0 ${heightClass} ${opacityClass} ${klass}`} aria-hidden="true">
  <svg
    class="h-full w-full"
    viewBox="0 0 1440 640"
    preserveAspectRatio="xMidYMax slice"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="terrain-noise" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.012 0.022" numOctaves="5" seed="11" result="noise" />
        <feDiffuseLighting in="noise" surfaceScale="11" diffuseConstant="1.35" lighting-color="#8a8a8a" result="light">
          <feDistantLight azimuth="235" elevation="34" />
        </feDiffuseLighting>
        <feComponentTransfer in="light" result="dim">
          <feFuncR type="linear" slope="0.4" intercept="0" />
          <feFuncG type="linear" slope="0.4" intercept="0" />
          <feFuncB type="linear" slope="0.42" intercept="0" />
        </feComponentTransfer>
        <feColorMatrix in="dim" type="matrix" values="0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0.33 0.33 0.33 0 0  0 0 0 1 0" />
      </filter>

      <linearGradient id="terrain-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#000000" stop-opacity="0" />
        <stop offset="35%" stop-color="#000000" stop-opacity="0.55" />
        <stop offset="100%" stop-color="#000000" stop-opacity="1" />
      </linearGradient>

      <mask id="terrain-mask">
        <rect x="0" y="0" width="1440" height="640" fill="url(#terrain-fade-mask)" />
      </mask>
      <linearGradient id="terrain-fade-mask" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#000000" />
        <stop offset="22%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#ffffff" />
      </linearGradient>
    </defs>

    <rect x="0" y="0" width="1440" height="640" filter="url(#terrain-noise)" mask="url(#terrain-mask)" />
    <rect x="0" y="0" width="1440" height="640" fill="url(#terrain-fade)" />
  </svg>
</div>
