---
import { profile, socialLinks } from "../data/social";
---

<section id="contact" class="relative scroll-mt-28 px-4 py-28 md:py-40">
  <div class="mx-auto max-w-3xl text-center">
    <div data-reveal>
      <span class="eyebrow">Contact</span>
      <h2 class="mt-4 text-balance font-display text-[clamp(2.25rem,5vw,3.5rem)] font-semibold leading-[1.05] text-ink">
        Let's build something worth shipping.
      </h2>
      <p class="mx-auto mt-6 max-w-md text-balance leading-relaxed text-ink-muted">
        Open to ML/AI and software engineering roles, collaborations, and interesting problems.
        Reach out — I reply fast.
      </p>
    </div>

    <div data-reveal data-reveal-delay="120" class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`mailto:${profile.email}`}
        data-magnetic
        class="group inline-flex items-center gap-3 rounded-full bg-white px-7 py-3.5 text-sm font-semibold text-black transition-transform duration-150 ease-[var(--ease-out-strong)]"
      >
        Email me
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-black/10 transition-transform duration-200 ease-[var(--ease-out-strong)] pointer-fine:group-hover:translate-x-1 pointer-fine:group-hover:-translate-y-[1px]"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M7 17L17 7M17 7H9M17 7V15" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      {
        socialLinks
          .filter((l) => l.label !== "Email")
          .map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              data-magnetic
              class="inline-flex items-center gap-2 rounded-full border border-hairline-strong px-6 py-3.5 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-white/5"
            >
              {link.label}
            </a>
          ))
      }
    </div>

    <p data-reveal data-reveal-delay="200" class="mt-8 text-sm text-ink-faint">
      {profile.email} · {profile.phone} · {profile.location}
    </p>
  </div>
</section>
