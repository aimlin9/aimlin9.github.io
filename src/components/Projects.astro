---
import { projects } from "../data/projects";
import { profile } from "../data/social";

const spanClass = {
  lg: "md:col-span-8 md:row-span-2",
  md: "md:col-span-4",
  sm: "md:col-span-4",
};
---

<section class="relative px-4 py-16 md:py-24">
  <div class="mx-auto max-w-5xl">
    <div data-reveal class="mb-14 flex flex-wrap items-end justify-between gap-6">
      <div>
        <span class="eyebrow">More builds</span>
        <h2 class="mt-4 text-balance font-display text-3xl font-semibold text-ink md:text-4xl">
          A few others worth a look
        </h2>
      </div>
      <a
        href={`https://github.com/${profile.githubUsername}`}
        target="_blank"
        rel="noreferrer"
        data-magnetic
        class="inline-flex items-center gap-2 rounded-full border border-hairline-strong px-5 py-2.5 text-sm font-semibold text-ink transition-colors duration-200 hover:bg-white/5"
      >
        All repos on GitHub
      </a>
    </div>

    <div class="grid grid-cols-1 gap-5 md:auto-rows-[13rem] md:grid-cols-12">
      {
        projects.map((project, i) => (
          <a
            href={project.href}
            target={project.href === "#" ? undefined : "_blank"}
            rel="noreferrer"
            data-reveal
            data-reveal-delay={i * 80}
            class={`glass-shell glass-core group relative flex flex-col justify-between overflow-hidden rounded-[2rem] p-7 transition-transform duration-300 ease-[var(--ease-out-strong)] pointer-fine:hover:-translate-y-1 ${spanClass[project.size]}`}
          >
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-20"
              style="background: radial-gradient(circle, var(--color-accent), transparent 70%);"
            />
            <div>
              <div class="flex items-center justify-between">
                <h3 class="font-display text-xl font-semibold text-ink">{project.title}</h3>
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/5 transition-transform duration-200 ease-[var(--ease-out-strong)] pointer-fine:group-hover:translate-x-1 pointer-fine:group-hover:-translate-y-[1px]"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M7 17L17 7M17 7H9M17 7V15" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted">{project.description}</p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-hairline px-2.5 py-1 text-[0.7rem] font-medium text-ink-faint">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
