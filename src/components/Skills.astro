---
import { skillGroups } from "../data/skills";

const spans = ["md:col-span-7", "md:col-span-5", "md:col-span-5", "md:col-span-7"];
---

<section id="skills" class="relative px-4 py-28 md:py-36">
  <div class="mx-auto max-w-5xl">
    <div data-reveal class="mb-14">
      <span class="eyebrow">Toolkit</span>
      <h2 class="mt-4 text-balance font-display text-3xl font-semibold text-ink md:text-4xl">
        What I build with
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-12">
      {
        skillGroups.map((group, i) => (
          <div
            data-reveal
            data-reveal-delay={i * 90}
            class={`glass-shell glass-core rounded-[2rem] p-8 ${spans[i % spans.length]}`}
          >
            <h3 class="font-display text-lg font-semibold text-ink">{group.label}</h3>
            <div class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full border border-hairline px-3 py-1.5 text-xs font-medium text-ink-muted">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
