---
import { skillGroups } from "../data/skills";
---

<section id="skills" class="relative scroll-mt-28 px-4 py-28 md:py-36">
  <div class="mx-auto max-w-4xl">
    <div data-reveal class="mb-16">
      <span class="eyebrow">Toolkit</span>
      <h2 class="mt-4 text-balance font-display text-3xl font-semibold text-ink md:text-4xl">
        What I build with
      </h2>
    </div>

    <div class="flex flex-col gap-16">
      {
        skillGroups.map((group, gi) => (
          <div data-reveal data-reveal-delay={gi * 80}>
            <div class="flex items-baseline justify-between gap-4 border-b border-hairline-strong pb-4">
              <h3 class="font-display text-2xl font-semibold text-ink md:text-3xl">{group.label}</h3>
              <span class="eyebrow shrink-0">
                {String(group.items.length).padStart(2, "0")}
              </span>
            </div>
            <ul>
              {group.items.map((item, i) => (
                <li class="group flex items-center justify-between gap-6 border-b border-hairline py-4 transition-colors duration-200 hover:border-accent/40">
                  <span class="text-base text-ink-muted transition-colors duration-200 group-hover:text-ink md:text-lg">
                    {item}
                  </span>
                  <span class="font-display text-sm text-ink-faint">{String(i + 1).padStart(2, "0")}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
