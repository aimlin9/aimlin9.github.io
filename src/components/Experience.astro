---
import { experience, education } from "../data/experience";
---

<section id="experience" class="relative scroll-mt-28 px-4 py-28 md:py-36">
  <div class="mx-auto max-w-4xl">
    <div data-reveal class="mb-14">
      <span class="eyebrow">Experience</span>
      <h2 class="mt-4 text-balance font-display text-3xl font-semibold text-ink md:text-4xl">
        Where I've been learning
      </h2>
    </div>

    <ol class="relative border-l border-hairline pl-8">
      {
        experience.map((item, i) => (
          <li data-reveal data-reveal-delay={i * 100} class="relative mb-12 last:mb-0">
            <span
              class:list={[
                "absolute -left-[calc(2rem+1px)] top-1.5 h-2.5 w-2.5 rounded-full",
                item.current ? "bg-accent" : "bg-ink-faint",
              ]}
            />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="font-display text-lg font-semibold text-ink">{item.role}</h3>
              <span class="text-xs uppercase tracking-[0.15em] text-ink-faint">{item.period}</span>
            </div>
            <p class="mt-1 text-sm font-medium text-ink-muted">{item.org} · {item.location}</p>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{item.description}</p>
          </li>
        ))
      }
    </ol>

    <div data-reveal class="glass-shell glass-core mt-16 rounded-[2rem] p-8">
      <span class="eyebrow">Education</span>
      <h3 class="mt-3 font-display text-xl font-semibold text-ink">{education.degree}</h3>
      <p class="mt-1 text-sm font-medium text-ink-muted">{education.school} · {education.period}</p>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{education.detail}</p>
    </div>
  </div>
</section>
